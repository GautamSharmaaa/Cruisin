{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "railway/admin.Dockerfile",
    "watchPatterns": [
      "/admin/**",
      "/railway/admin.Dockerfile",
      "/.dockerignore",
      "/package.json",
      "/package-lock.json"
    ]
  },
  "deploy": {
    "startCommand": "npm --workspace admin run start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
