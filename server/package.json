{
  "_governedBy": ".rules v1.0",
  "name": "@cruisin/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch index.ts",
    "dev:logistics-worker": "tsx watch logistics-worker.ts",
    "logistics:e2e:api": "tsx index.ts",
    "logistics:e2e:worker": "tsx logistics-worker.ts",
    "logistics:e2e:serve": "npm-run-all --parallel logistics:e2e:api logistics:e2e:worker",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:logistics-worker": "node dist/logistics-worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:logistics": "SHIPROCKET_ENABLED=true SHIPROCKET_MODE=mock SHIPROCKET_ALLOW_LIVE_READS=false SHIPROCKET_ALLOW_LIVE_MUTATIONS=false vitest run src/services/logistics/logistics-core.test.ts src/services/logistics/logistics-automation.test.ts src/services/logistics/logistics-index-contract.test.ts src/services/logistics/logistics-notification-core.test.ts src/services/logistics/logistics-notification-dispatch.test.ts src/services/logistics/logistics-webhook-replay.test.ts src/utils/send-logistics-message.test.ts src/routes/v1/logistics-security.routes.test.ts src/routes/v1/logistics-webhook.routes.test.ts",
    "db:indexes": "tsx src/scripts/ensure-indexes.ts",
    "db:indexes:production": "node dist/src/scripts/ensure-indexes.js",
    "logistics:e2e:seed": "tsx src/scripts/seed-logistics-e2e.ts",
    "bootstrap:storefront": "tsx src/scripts/bootstrap-storefront.ts",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "seed": "tsx src/scripts/seed.ts",
    "analytics:test:seed": "tsx src/scripts/seed-analytics-simulation.ts",
    "analytics:test:cleanup": "tsx src/scripts/cleanup-analytics-simulation.ts",
    "migrate:identity": "tsx src/scripts/migrate-identity.ts",
    "shiprocket:smoke:readonly": "tsx src/scripts/shiprocket-live-smoke.ts",
    "shiprocket:cleanup:live": "tsx src/scripts/shiprocket-live-cleanup.ts"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.3",
    "@sentry/node": "^10.58.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "8.24.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "razorpay": "^2.9.5",
    "stripe": "^14.25.0",
    "twilio": "^6.0.2",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
}
