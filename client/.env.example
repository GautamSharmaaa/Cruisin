# Governed by .rules v1.0
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_PROXY_TARGET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_WHATSAPP_OTP_ENABLED=true
# Optional. Use the same dataset ID as META_PIXEL_ID on the API.
NEXT_PUBLIC_META_PIXEL_ID=
# Marketing is on by default when a Pixel is configured. Use opt-in where prior permission is required.
NEXT_PUBLIC_META_MARKETING_DEFAULT=opt-out
