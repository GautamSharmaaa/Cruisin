{
  "_governedBy": ".rules v1.0",
  "private": true,
  "name": "cruisin-luxury-ecom",
  "version": "1.0.0",
  "workspaces": [
    "client",
    "admin",
    "server"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client dev:admin",
    "dev:client": "npm --workspace client run dev",
    "dev:admin": "npm --workspace admin run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspaces run build",
    "typecheck": "npm --workspaces run typecheck",
    "lint": "npm --workspaces run lint",
    "test": "npm --workspace server run test && npm --workspace client run test",
    "test:e2e": "npm --workspace client run test:e2e"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  }
}
