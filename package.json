{
  "_governedBy": ".rules v1.0",
  "private": true,
  "name": "cruisin-luxury-ecom",
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "client",
    "admin",
    "server"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client dev:admin",
    "dev:db": "docker compose up -d mongo",
    "dev:db:down": "docker compose down",
    "dev:client": "npm --workspace client run dev",
    "dev:admin": "npm --workspace admin run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspaces run build",
    "typecheck": "npm --workspaces run typecheck",
    "lint": "npm --workspaces run lint",
    "test": "npm --workspace server run test && npm --workspace client run test && npm --workspace admin run test",
    "test:e2e": "npm --workspace client run test:e2e",
    "test:e2e:logistics": "npm --workspace client run test:e2e:logistics",
    "verify:logistics": "SHIPROCKET_ENABLED=false SHIPROCKET_MODE=mock SHIPROCKET_ALLOW_LIVE_READS=false SHIPROCKET_ALLOW_LIVE_DOCUMENTS=false SHIPROCKET_ALLOW_LIVE_MUTATIONS=false npm-run-all --sequential lint typecheck test build verify:logistics:focused verify:logistics:secrets",
    "verify:logistics:focused": "npm --workspace server run verify:logistics",
    "verify:logistics:secrets": "node scripts/verify-logistics-secrets.mjs"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "next": "15.5.23",
    "postcss": "8.5.26",
    "nanoid": "3.3.18",
    "sharp": "0.35.0"
  }
}
